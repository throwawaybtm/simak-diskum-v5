rules_version = '2';

// LOCAL EMULATOR DEVELOPMENT RULES ONLY
// WARNING: NEVER DEPLOY TO PRODUCTION OR STAGING.
// firebase.json intentionally references 'firebase/firestore.rules' (deny-by-default).
// This file is used explicitly by local integration test runners and the local emulator.

service cloud.firestore {
  match /databases/{database}/documents {
    // In local emulator mode, allow public collections to be read anonymously and written by maintainer scripts
    match /publicActivities/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /publicAnnouncements/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /publicSettings/{id} {
      allow read: if true;
      allow write: if true;
    }

    // In local emulator mode, allow admin activity mutations and master data CRUD for testing
    match /activities/{id} {
      allow read, write: if true;
    }
    match /employees/{id} {
      allow read, write: if true;
    }
    match /departments/{id} {
      allow read, write: if true;
    }
    match /locations/{id} {
      allow read, write: if true;
    }
    match /organizers/{id} {
      allow read, write: if true;
    }
    match /categories/{id} {
      allow read, write: if true;
    }
    match /auditLogs/{id} {
      allow read, write: if true;
    }
    match /announcements/{id} {
      allow read, write: if true;
    }
    match /settings/{id} {
      allow read, write: if true;
    }
  }
}
