rules_version = '2';

// ===============================================================
// SIMAK DISKUM Kota Batam v5.0 — Temporary Maintenance Security Rules
// ===============================================================
// Purpose:
// Freezes all client-side mutations during database restoration, migrations,
// or emergency disaster recovery, while preserving read-only access for citizens
// and authenticated department personnel.
//
// Admin SDK Connectivity:
// Privileged administrative scripts (scripts/backupRestore.mjs) connect via
// Firebase Admin SDK (ADC or service account) and bypass these rules entirely.
//
// Reversibility:
// Normal rules are restored instantly by redeploying firebase/firestore.rules:
//   firebase deploy --project simakdiskum --only firestore:rules
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isEditorOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'editor' ||
        request.auth.token.role == 'admin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 1. Public Activities: Read-Only for Public and Clients
    match /publicActivities/{activityId} {
      allow read: if true;
      allow write: if false; // All client mutations blocked during maintenance
    }

    // 2. Private Activities: Read-Only for Logged-In Operators, Writes Blocked
    match /activities/{activityId} {
      allow read: if isEditorOrAdmin();
      allow write: if false; // All client mutations blocked during maintenance
    }

    // 3. Audit Logs: Read-Only for Admin, Client Writes Blocked
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK writes via backupRestore.mjs bypass this
    }

    // 4. Master Data: Read-Only for Authenticated Users, Writes Blocked
    match /employees/{id} { allow read: if isEditorOrAdmin(); allow write: if false; }
    match /departments/{id} { allow read: if isEditorOrAdmin(); allow write: if false; }
    match /locations/{id} { allow read: if isEditorOrAdmin(); allow write: if false; }
    match /organizers/{id} { allow read: if isEditorOrAdmin(); allow write: if false; }
    match /categories/{id} { allow read: if isEditorOrAdmin(); allow write: if false; }
    match /settings/{id} { allow read: if isEditorOrAdmin(); allow write: if false; }

    // 5. Public Announcements & Settings: Read-Only
    match /publicAnnouncements/{annId} { allow read: if true; allow write: if false; }
    match /publicSettings/{settingId} { allow read: if true; allow write: if false; }

    // 6. Default Deny-All Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
