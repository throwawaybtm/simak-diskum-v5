rules_version = '2';

// STRICT PRODUCTION & STAGING RULES BASELINE
// Pre-Gate 5: Hosted Firestore writes are completely denied.
// All browser-based validation, regex scanning, and conflict detection are client ergonomics, NOT security boundaries.
// Permissive rules for local testing MUST ONLY be loaded into the local emulator via emulator.rules.

service cloud.firestore {
  match /databases/{database}/documents {
    // Public sanitized projection collections (read-only anonymously)
    match /publicActivities/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /publicAnnouncements/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /publicSettings/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Private collections (activities, master data, audit logs, settings):
    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
