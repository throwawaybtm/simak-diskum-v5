{
  "name": "department-agenda-firebase",
  "version": "5.0.0",
  "description": "Department Activity Scheduling System v5.0 for Dinas Koperasi dan Usaha Mikro Kota Batam",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "dev:public": "npm --workspace=@department-agenda/public run dev",
    "dev:admin": "npm --workspace=@department-agenda/admin run dev",
    "build:shared": "npm --workspace=@department-agenda/shared run build",
    "build:public": "npm --workspace=@department-agenda/public run build",
    "build:admin": "npm --workspace=@department-agenda/admin run build",
    "build": "npm run build:shared && npm run build:public && npm run build:admin",
    "test": "vitest run --no-file-parallelism",
    "test:e2e": "node tests/e2e/runVerification.mjs",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --config firebase.emulator.json --project demo-department-agenda --only firestore,hosting",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "playwright": "^1.64.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
